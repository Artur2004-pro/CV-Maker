node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# ============================================
# Environment Variables (Շրջակա միջավայրի փոփոխականներ)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# ============================================
# Build Outputs (Կառուցման արդյունքներ)
# ============================================
dist/
build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo
*.build

# ============================================
# IDE & Editor Files (IDE և խմբագրիչի ֆայլեր)
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ============================================
# OS Files (Օպերացիոն համակարգի ֆայլեր)
